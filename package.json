{
  "name": "showit",
  "version": "0.3.0",
  "private": true,
  "description": "Showit local presentation workspace (Chrome extension, WXT)",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @showit/extension",
    "build": "npm run build -ws --if-present && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle-size.mjs extension",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "test:extension-browser": "node scripts/playwright-extension-smoke.mjs",
    "test:extension-e2e": "node scripts/playwright-extension-e2e.mjs",
    "icons": "node scripts/make-icons.mjs apps/extension/public/icons",
    "release:extension": "npm run build -w @showit/extension && npm run bundle:check && node scripts/package-extension.mjs",
    "test:extension-demo-e2e": "node scripts/playwright-extension-demo-e2e.mjs",
    "test:remote-e2e": "node scripts/playwright-remote-e2e.mjs",
    "relay:dev": "npm run dev -w @showit/relay",
    "build:demo-site": "npm run build -w @showit/demo-site"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
